
funcs:([] fullname:(); ns:(); description:(); name:(); other:());
.man.registerFunc:{`funcs insert `fullname`ns`description`name`other!(),/:x};
args:([] fullname:(); tag:(); param:(); description:());
.man.registerArg:{`args insert `fullname`tag`param`description!(),/:x};
files:([] title:(); author:(); namespaces:(); header:());
.man.registerFile:{`files insert `title`author`namespaces`header!(),/:x};
filetags:([] title:(); tag:(); val:());
.man.registerFileTag:{`filetags insert `title`tag`val!(),/:x};

getDocs:{[]
    headerTbl:select {"<p>",x,"</p>"} "\n" sv header by title,fullname:{first "|" vs x} each namespaces from files where 1<count each trim namespaces,1<count each trim header;
    toList:{{"<ul>",("" sv x),"</ul>"} {"<li>",x[0]," ",x[1],"</li>"} each x};
    tagTbl:select html:toList flip (tag;val) by title from filetags;
    t:select description:("<br />" sv header,html) by fullname from headerTbl lj tagTbl;

    u:args lj select d:toList flip (param;description) by fullname,tag from args where 0<count each param;
    u:select "" sv ?[0<count each param; d;description] by fullname,tag from u;
    (0!u) uj (0!t)};


