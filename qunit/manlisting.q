
funcs:([] fullname:(); ns:(); description:(); name:(); other:());
.man.registerFunc:{`funcs insert `fullname`ns`description`name`other!(),/:x};
args:([] fullname:(); tag:(); param:(); description:());
.man.registerArg:{`args insert `fullname`tag`param`description!(),/:x};

